# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# local SQLite runtime files
/data/*.db
/data/*.db-*

# 민감정보 수집 결과물 (한전 비밀번호, 업체 상세, 고객 DB 등)
/data/kepco-passwds.*
/data/firm-details.*
/data/*.xlsx
/data/*.xls
/data/*.csv
/data/~$*

# 한전 비밀번호 매칭 결과 (scripts/match-kepco-passwds.mjs 생성, 로컬 전용)
/src/lib/fit-mocks/kepco-passwds.json

# 한전 수집 런타임 로그·진행 체크포인트·완료 리포트 (로컬 전용)
/data/kepco-*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

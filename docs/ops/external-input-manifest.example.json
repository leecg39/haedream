      "snapshotPath": "/ABS/PATH/OUTSIDE/REPO/local-live-post-011.deid.db",
      "expectedSha256": "REPLACE_HEX64"
    },
    {
      "type": "register-observation",
      "envAlias": "REPLACE_SCHEDULER_ENV",
      "startDate": "YYYY-MM-DD",
      "plannedDays": 7,
      "alertOwner": "REPLACE_ONCALL_ALIAS",
      "faultInjectApproved": false
    },
    {
      "type": "declare-external-env",
      "iConfirmInventory": true,
      "operator": "REPLACE_OPERATOR_ID",
      "environments": [
        {
          "alias": "hostinger-vps-1",
          "hostsSolarSimz": false,
          "pre011BackupProvenance": "n/a-no-solarsimz-on-host"
        },
        {
          "alias": "REPLACE_REAL_ENV",
          "hostsSolarSimz": true,
          "offlineSnapshotPath": "/ABS/PATH/OUTSIDE/REPO/env-offline.db",
          "pre011BackupProvenance": "REPLACE_BACKUP_HASH_ALIAS_OR_NONE"
        }
      ]
    }
  ]
}
